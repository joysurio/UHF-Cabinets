<Window x:Class="UHFCabinets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Software Manager iTRACE® — UHF Cabinets"
        WindowState="Maximized"
        WindowStyle="None"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="CanResize"
        MinWidth="480"
        MinHeight="420">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Chrome: title strip is draggable; right side has window controls -->
        <Border x:Name="ChromeBar"
                Grid.Row="0"
                Background="{StaticResource ChromeBarGradientBrush}"
                Padding="22,12,20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ChromeDragArea"
                        Background="Transparent"
                        VerticalAlignment="Stretch"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="ChromeDragArea_OnMouseLeftButtonDown">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="Software Manager iTRACE®"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextOnPrimaryBrush}"/>
                        <TextBlock Text="UHF Cabinets"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="12.5"
                                   Margin="0,4,0,0"
                                   Foreground="#B8D9FF"
                                   Opacity="0.98"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,-8,0">
                    <Border VerticalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="#FFFFFF66"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,5"
                            Margin="0,0,8,0">
                        <TextBlock Text="Touch UI"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                    </Border>
                    <Button Style="{StaticResource WindowChromeButton}"
                            Click="WindowChrome_Minimize_Click"
                            ToolTip="Minimize">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE921;"
                                   FontSize="12"
                                   Foreground="{StaticResource TextOnPrimaryBrush}"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton"
                            Style="{StaticResource WindowChromeButton}"
                            Click="WindowChrome_MaximizeRestore_Click"
                            ToolTip="Maximize">
                        <Grid Width="16" Height="16">
                            <TextBlock x:Name="MaximizeGlyph"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE922;"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextOnPrimaryBrush}"/>
                            <TextBlock x:Name="RestoreGlyph"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE923;"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource TextOnPrimaryBrush}"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource WindowChromeCloseButton}"
                            Click="WindowChrome_Close_Click"
                            ToolTip="Close">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE8BB;"
                                   FontSize="12"
                                   Foreground="{StaticResource TextOnPrimaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Height="3" Background="{StaticResource ChromeAccentLineBrush}"/>
        <Frame x:Name="MainFrame"
               Grid.Row="2"
               NavigationUIVisibility="Hidden"
               Background="Transparent"/>
    </Grid>
</Window>
