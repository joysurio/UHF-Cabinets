<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Brand -->
    <Color x:Key="PrimaryColor">#0D5CAB</Color>
    <Color x:Key="PrimaryLightColor">#1B6EC5</Color>
    <Color x:Key="PrimaryDarkColor">#0A4A8A</Color>
    <Color x:Key="SecondaryColor">#0F3460</Color>
    <Color x:Key="SecondaryLightColor">#1E4F8F</Color>

    <!-- Surfaces -->
    <Color x:Key="BackgroundColor">#EEF2F7</Color>
    <Color x:Key="BackgroundDeepColor">#E2E8F0</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceSubtleColor">#F8FAFC</Color>
    <Color x:Key="BorderColor">#CBD5E1</Color>
    <Color x:Key="BorderLightColor">#E2E8F0</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#0F172A</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <Color x:Key="SuccessColor">#0D9488</Color>
    <Color x:Key="WarningColor">#EA580C</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="InfoAccentColor">#2563EB</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryDarkColor}"/>

    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="{StaticResource SecondaryLightColor}"/>
    <SolidColorBrush x:Key="SecondaryPressedBrush" Color="#0A2540"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoAccentBrush" Color="{StaticResource InfoAccentColor}"/>

    <Color x:Key="AccentSkyColor">#38BDF8</Color>
    <SolidColorBrush x:Key="AccentSkyBrush" Color="{StaticResource AccentSkyColor}"/>

    <!-- App chrome -->
    <LinearGradientBrush x:Key="ChromeBarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1568C4" Offset="0"/>
        <GradientStop Color="#0D5CAB" Offset="0.55"/>
        <GradientStop Color="#0A3F75" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ChromeAccentLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#38BDF8" Offset="0"/>
        <GradientStop Color="#0D9488" Offset="0.52"/>
        <GradientStop Color="#7DD3FC" Offset="1"/>
    </LinearGradientBrush>

    <!-- Page wash + ambient depth -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F4F7FD" Offset="0"/>
        <GradientStop Color="#E8EEF8" Offset="0.38"/>
        <GradientStop Color="#DDE6F4" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="PageAmbientGlowBrush" GradientOrigin="0.12,0" Center="0.08,0" RadiusX="0.85" RadiusY="0.55">
        <GradientStop Color="#66C7DBF7" Offset="0"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="PageAmbientGlowBrushSecondary" GradientOrigin="1,0.9" Center="0.92,0.95" RadiusX="0.75" RadiusY="0.5">
        <GradientStop Color="#55A8E4DC" Offset="0"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </RadialGradientBrush>

    <!-- Primary actions -->
    <LinearGradientBrush x:Key="PrimaryButtonFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2490E8" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0.45"/>
        <GradientStop Color="{StaticResource PrimaryDarkColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryButtonFaceHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3BA3F5" Offset="0"/>
        <GradientStop Color="#1B6EC5" Offset="0.5"/>
        <GradientStop Color="#0D5CAB" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FAFBFD" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="32"
                      ShadowDepth="4"
                      Opacity="0.11"
                      Direction="272"
                      Color="#0F172A"/>

    <DropShadowEffect x:Key="PrimaryGlowShadow"
                      BlurRadius="24"
                      ShadowDepth="0"
                      Opacity="0.22"
                      Color="#1D4ED8"/>
</ResourceDictionary>
