<Page x:Class="UHFCabinets.Views.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Rectangle Fill="{StaticResource PageAmbientGlowBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource PageAmbientGlowBrushSecondary}" IsHitTestVisible="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24">
            <StackPanel MaxWidth="620"
                        MinWidth="280"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,36">
                <Border Style="{StaticResource ElevatedCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource ChromeAccentLineBrush}" CornerRadius="16,16,0,0"/>
                        <StackPanel Grid.Row="1" Margin="32,28,32,32">
                            <TextBlock x:Name="WelcomeText"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Choose an action"
                                       Style="{StaticResource PageSubtitleText}"
                                       FontSize="15"
                                       Margin="0,0,0,26"/>
                            <Button Style="{StaticResource MenuNavButton}"
                                    Click="OnInventory"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" Background="#E8F1FC" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE8FD;"
                                                   FontSize="24"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Inventory" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Review on-hand quantities by product" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE76C;"
                                               FontSize="15"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource MenuNavButton}"
                                    Click="OnDispense"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" Background="#E8F1FC" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE896;"
                                                   FontSize="24"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Dispense / Restock" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Run a door cycle and capture RFID movements" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE76C;"
                                               FontSize="15"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,8,0,20"/>
                            <Button Content="Logout"
                                    Style="{StaticResource SecondaryAppButton}"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="52"
                                    FontSize="16"
                                    Foreground="{StaticResource TextOnPrimaryBrush}"
                                    Click="OnLogout"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
