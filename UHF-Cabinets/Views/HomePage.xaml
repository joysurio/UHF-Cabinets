<Page x:Class="UHFCabinets.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Rectangle Fill="{StaticResource PageAmbientGlowBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource PageAmbientGlowBrushSecondary}" IsHitTestVisible="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="28,28,28,36">
            <StackPanel VerticalAlignment="Center"
                        MaxWidth="760"
                        MinWidth="280"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,28">
                <Border Style="{StaticResource ElevatedCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{StaticResource ChromeAccentLineBrush}"
                                CornerRadius="16,16,0,0"/>
                        <StackPanel Grid.Row="1" Margin="40,36,40,40">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,22">
                                <Border Style="{StaticResource StatusPillBorder}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cabinet OK" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatusPillBorder}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Network" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatusPillBorder}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Power" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="48" Height="48" CornerRadius="14" Background="#E8F1FC" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE716;"
                                               FontSize="24"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Welcome"
                                               Style="{StaticResource PageTitleText}"
                                               FontSize="34"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Style="{StaticResource PageSubtitleText}"
                                               Text="UHF Cabinets · Software Manager iTRACE®"
                                               FontSize="16"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource PageSubtitleText}"
                                       Text="Touch below to identify yourself and continue to the secure cabinet workspace."
                                       Margin="0,0,0,36"/>
                            <Button Style="{StaticResource HeroCtaButton}"
                                    Content="Touch to start"
                                    HorizontalAlignment="Stretch"
                                    Click="OnTouchStart"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE8D7;"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Secure cabinet access and inventory management"
                               TextAlignment="Center"
                               FontSize="13.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
