<Page x:Class="UHFCabinets.Views.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Rectangle Fill="{StaticResource PageAmbientGlowBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource PageAmbientGlowBrushSecondary}" IsHitTestVisible="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24">
            <StackPanel MaxWidth="960" MinWidth="320" HorizontalAlignment="Stretch">
                <StackPanel Margin="0,0,0,22">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="4" Height="28" CornerRadius="2" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Style="{StaticResource PageTitleText}" Text="Inventory" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource PageSubtitleText}"
                               Text="Quantities are based on the last RFID scan and your local item catalog."
                               Margin="16,0,0,0"/>
                </StackPanel>
                <Border Style="{StaticResource ElevatedCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource ChromeAccentLineBrush}" CornerRadius="16,16,0,0"/>
                        <StackPanel Grid.Row="1" Margin="26,24,26,26">
                            <TextBlock Text="Stock by product"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                       Margin="0,0,0,14"/>
                            <DataGrid x:Name="InventoryGrid"
                                      MinHeight="220"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product name" Binding="{Binding Producto}" Width="*"/>
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Back"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    MinWidth="128"
                                    Margin="0,22,0,0"
                                    Click="OnBack"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
