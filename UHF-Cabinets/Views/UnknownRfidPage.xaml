<Page x:Class="UHFCabinets.Views.UnknownRfidPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Rectangle Fill="{StaticResource PageAmbientGlowBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource PageAmbientGlowBrushSecondary}" IsHitTestVisible="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24">
            <StackPanel MaxWidth="920" MinWidth="320" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="4" Height="28" CornerRadius="2" Background="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Style="{StaticResource PageTitleText}" Text="Unknown RFID tags" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{StaticResource PageSubtitleText}"
                           Text="Each tag must be linked to a product before you can complete the operation. No skipping."
                           Margin="16,0,0,20"/>
                <Border Style="{StaticResource ElevatedCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource ChromeAccentLineBrush}" CornerRadius="16,16,0,0"/>
                        <Grid Grid.Row="1" Margin="24,22,24,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                <StackPanel x:Name="RowsPanel"/>
                            </ScrollViewer>
                            <TextBlock x:Name="StatusText"
                                       Grid.Row="1"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource ErrorBrush}"
                                       FontSize="14"
                                       Margin="0,12,0,0"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="Save"
                                        MinWidth="140"
                                        Margin="0,0,12,0"
                                        Click="OnSave"/>
                                <Button Content="Cancel"
                                        Style="{StaticResource GhostButton}"
                                        MinWidth="120"
                                        Click="OnCancel"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
