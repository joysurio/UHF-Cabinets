<Page x:Class="UHFCabinets.Views.OperationSummaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Rectangle Fill="{StaticResource PageAmbientGlowBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource PageAmbientGlowBrushSecondary}" IsHitTestVisible="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24">
            <StackPanel VerticalAlignment="Center"
                        MaxWidth="560"
                        MinWidth="280"
                        HorizontalAlignment="Center"
                        Margin="0,28,0,36">
                <Border Style="{StaticResource ElevatedCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource ChromeAccentLineBrush}" CornerRadius="16,16,0,0"/>
                        <StackPanel Grid.Row="1" Margin="40,36,40,40">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE73E;"
                                       FontSize="36"
                                       Foreground="{StaticResource SuccessBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="Operation complete"
                                       Style="{StaticResource PageTitleText}"
                                       TextAlignment="Center"
                                       FontSize="28"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Summary of detected movements"
                                       Style="{StaticResource PageSubtitleText}"
                                       TextAlignment="Center"
                                       Margin="0,0,0,28"/>
                            <Border Background="#F0F7FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="22,18"
                                    Margin="0,0,0,12">
                                <TextBlock x:Name="SalidasText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            </Border>
                            <Border Background="#F0FDF9"
                                    BorderBrush="#99F6E4"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="22,18"
                                    Margin="0,0,0,28">
                                <TextBlock x:Name="EntradasText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            </Border>
                            <Button Content="Back to menu"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="54"
                                    Click="OnOk"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
