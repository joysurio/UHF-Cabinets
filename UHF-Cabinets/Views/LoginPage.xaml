<Page x:Class="UHFCabinets.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Rectangle Fill="{StaticResource PageAmbientGlowBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource PageAmbientGlowBrushSecondary}" IsHitTestVisible="False"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24">
            <Grid MaxWidth="540" MinWidth="280" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="#E8F1FC"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,14"
                        Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE946;"
                                   FontSize="20"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock Style="{StaticResource PageSubtitleText}"
                                   TextAlignment="Left"
                                   Text="Use your HF card at the cabinet reader to identify yourself, or sign in below."
                                   FontSize="14.5"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource ChromeAccentLineBrush}" CornerRadius="16,16,0,0"/>
                        <Grid Grid.Row="1" Margin="36,30,36,34">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Width="44" Height="44" CornerRadius="12" Background="#E8F1FC" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE77B;"
                                               FontSize="22"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Sign in" Style="{StaticResource PageTitleText}" FontSize="24" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource PageSubtitleText}" Text="Username and password" FontSize="14" Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Username" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox x:Name="UserNameBox" Margin="0,0,0,18"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Password" Style="{StaticResource FormFieldLabel}"/>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="PasswordBox"
                                                 Grid.Column="0"
                                                 Grid.ColumnSpan="2"
                                                 Padding="14,12,52,12"
                                                 VerticalContentAlignment="Center"/>
                                    <TextBox x:Name="PasswordPlainBox"
                                             Grid.Column="0"
                                             Grid.ColumnSpan="2"
                                             Padding="14,12,52,12"
                                             VerticalContentAlignment="Center"
                                             Visibility="Collapsed"/>
                                    <Button Grid.Column="1"
                                            x:Name="TogglePasswordVisibilityButton"
                                            Margin="0,2,4,2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource PasswordRevealButton}"
                                            Click="OnTogglePasswordVisibility"
                                            ToolTip="Show password"
                                            AutomationProperties.Name="Show password">
                                        <Grid Width="22" Height="22">
                                            <TextBlock x:Name="EyeRevealGlyph"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE7B3;"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="EyeHideGlyph"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xED1A;"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="3">
                                <Button Content="Sign in"
                                        HorizontalAlignment="Stretch"
                                        MinHeight="54"
                                        Click="OnSignIn"/>
                                <TextBlock x:Name="StatusText"
                                           Margin="0,16,0,0"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontSize="14"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
